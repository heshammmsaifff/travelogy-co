# ---------------------------------------------------------------------------
# Last Line Travel — environment template
# Copy to .env.local and fill in. .env.local is git-ignored; never commit real
# values, and never substitute a placeholder for a secret you don't have
# (CLAUDE.md §4, §14) — ask for it instead.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's current name for what used to be the anon key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — must never be exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary ------------------------------------------------------------
# API secret is server-only; uploads are signed by /api/media/signature (§8).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- App -------------------------------------------------------------------
# e.g. http://localhost:3000 in dev
NEXT_PUBLIC_SITE_URL=

# --- Deliberately NOT here -------------------------------------------------
# Payment gateway keys: there is no payment gateway in this platform, in any
#   phase (CLAUDE.md §10).
# External supplier keys (RateHawk, Hotelbeds, ...): the super_admin enters and
#   rotates these from the back-office; they are stored encrypted in Supabase
#   Vault, never as environment variables (CLAUDE.md §9).
