# ---------------------------------------------------------------------------
# Last Line Travel — environment template
# Copy to .env.local and fill in. .env.local is git-ignored; never commit real
# values, and never substitute a placeholder for a secret you don't have
# (CLAUDE.md §4, §14) — ask for it instead.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's current name for what used to be the anon key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — must never be exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary ------------------------------------------------------------
# API secret is server-only; uploads are signed by /api/media/signature (§8).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- App -------------------------------------------------------------------
# e.g. http://localhost:3000 in dev
NEXT_PUBLIC_SITE_URL=

# --- Reserved for later phases (leave empty until that phase starts) -------
# Payment gateway (Phase 9)
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_SECRET_KEY=

# External hotel/other suppliers (Phase 3b / Phase 10)
HOTEL_SUPPLIER_RATEHAWK_KEY_ID=
HOTEL_SUPPLIER_RATEHAWK_API_KEY=
HOTEL_SUPPLIER_HOTELBEDS_API_KEY=
HOTEL_SUPPLIER_HOTELBEDS_SECRET=
